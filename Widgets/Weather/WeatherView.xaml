<UserControl x:Class="Glasspane.Widgets.Weather.WeatherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}"
             Background="Transparent">

    <Grid Margin="16,0,14,12">
        <StackPanel>
            <!-- Place + options -->
            <DockPanel Margin="0,0,0,4">
                <Button x:Name="OptionsButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE713;"
                        ToolTip="Location and units" Click="OptionsButton_Click" />
                <Button x:Name="RefreshButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE72C;"
                        ToolTip="Update now" Click="Refresh_Click" />
                <TextBlock x:Name="PlaceText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>

            <!-- Now -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NowSymbol" FontFamily="Segoe UI Symbol" FontSize="40" VerticalAlignment="Center"
                           Margin="0,0,12,0" />
                <TextBlock x:Name="NowTemp" Grid.Column="1" FontSize="44" FontWeight="Light"
                           FontFamily="Segoe UI Variable Display, Segoe UI" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock x:Name="NowText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="NowHighLow" FontSize="12" Opacity="0.85" />
                </StackPanel>
            </Grid>
            <TextBlock x:Name="NowDetail" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,0"
                       TextWrapping="Wrap" />

            <!-- Next hours -->
            <UniformGrid x:Name="Hourly" Rows="1" Margin="0,14,0,0" />

            <!-- Next days -->
            <StackPanel x:Name="Daily" Margin="0,12,0,0" />

            <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="{StaticResource SubtleTextBrush}" Margin="0,10,0,0" />
        </StackPanel>

        <!-- Location and units -->
        <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}" Placement="Bottom"
               HorizontalOffset="-230" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Width="260">
                <StackPanel>
                    <TextBlock Text="Location" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" Style="{StaticResource GlassInput}" Tag="Search a town or city" KeyDown="SearchBox_KeyDown" />
                        <Button Grid.Column="1" Style="{StaticResource PillButton}" Content="Search" Margin="6,0,0,0" Click="Search_Click" />
                    </Grid>
                    <StackPanel x:Name="SearchResults" Margin="0,0,0,6" />

                    <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,6,0,10" />
                    <CheckBox x:Name="FahrenheitToggle" Style="{StaticResource ToggleSwitch}" Content="Fahrenheit (°F)"
                              FontSize="12" Margin="0,0,0,10" Click="Option_Click" />
                    <CheckBox x:Name="KmhToggle" Style="{StaticResource ToggleSwitch}" Content="Wind in km/h"
                              FontSize="12" Margin="0,0,0,10" Click="Option_Click" />
                    <CheckBox x:Name="HourlyToggle" Style="{StaticResource ToggleSwitch}" Content="Next hours"
                              FontSize="12" Margin="0,0,0,10" Click="Option_Click" />
                    <CheckBox x:Name="DailyToggle" Style="{StaticResource ToggleSwitch}" Content="Next 5 days"
                              FontSize="12" Click="Option_Click" />
                    <TextBlock Text="Weather from Open-Meteo.com" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
