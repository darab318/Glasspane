<UserControl x:Class="Glasspane.Widgets.Time.ClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Small round day toggles for alarm repeats -->
        <Style x:Key="DayChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bg" CornerRadius="13" Background="#14FFFFFF" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#29FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FF0B1220" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BigDigits" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="16,0,14,12">
        <StackPanel>
            <!-- Time and date -->
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TimeText" FontSize="48" FontWeight="Light"
                               FontFamily="Segoe UI Variable Display, Segoe UI" />
                    <TextBlock x:Name="SecondsText" FontSize="20" FontWeight="Light" Opacity="0.65"
                               VerticalAlignment="Bottom" Margin="4,0,0,11"
                               FontFamily="Segoe UI Variable Display, Segoe UI" />
                    <TextBlock x:Name="AmPmText" FontSize="16" Opacity="0.75" VerticalAlignment="Bottom" Margin="6,0,0,12" />
                </StackPanel>
                <Button x:Name="OptionsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                        HorizontalAlignment="Right" VerticalAlignment="Top" ToolTip="Clock options" Click="OptionsButton_Click" />
            </Grid>
            <TextBlock x:Name="DateText" FontSize="14" Opacity="0.9" Margin="2,-6,0,0" />
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" Margin="2,4,0,0"
                       TextWrapping="Wrap" />

            <!-- Sections: click a chip to open, click it again to close -->
            <StackPanel x:Name="TabRow" Orientation="Horizontal" Margin="0,12,0,0">
                <RadioButton x:Name="AlarmsTab" Style="{StaticResource Chip}" Content="Alarms" GroupName="ClockTabs"
                             PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown" Checked="Tab_Checked" />
                <RadioButton x:Name="TimerTab" Style="{StaticResource Chip}" Content="Timer" GroupName="ClockTabs"
                             PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown" Checked="Tab_Checked" />
                <RadioButton x:Name="StopwatchTab" Style="{StaticResource Chip}" Content="Stopwatch" GroupName="ClockTabs"
                             PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown" Checked="Tab_Checked" />
            </StackPanel>

            <!-- Alarms -->
            <StackPanel x:Name="AlarmsPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <ItemsControl x:Name="AlarmList" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="AlarmTime" Text="{Binding TimeText}" FontSize="22" FontWeight="Light"
                                           VerticalAlignment="Center" Margin="0,0,12,0" MinWidth="64" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding LabelText}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding RepeatText}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                                <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                          VerticalAlignment="Center" Click="AlarmToggle_Click" ToolTip="On / off" />
                                <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE74D;" FontSize="11"
                                        ToolTip="Delete alarm" Click="AlarmDelete_Click" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Enabled}" Value="False">
                                    <Setter TargetName="AlarmTime" Property="Opacity" Value="0.45" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock x:Name="NoAlarms" Text="No alarms yet" FontSize="12" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,8" />

                <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,2,0,10" />

                <TextBlock Text="New alarm" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="86" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewAlarmTime" Style="{StaticResource GlassInput}" Tag="07:30" Margin="0,0,8,0"
                             ToolTip="Time, e.g. 07:30, 7.30, 19:45 or 7:30pm" KeyDown="NewAlarm_KeyDown" />
                    <TextBox x:Name="NewAlarmLabel" Grid.Column="1" Style="{StaticResource GlassInput}" Tag="Label (optional)"
                             KeyDown="NewAlarm_KeyDown" />
                </Grid>
                <StackPanel x:Name="DayToggles" Orientation="Horizontal" Margin="0,0,0,4" />
                <TextBlock Text="Pick days to repeat, or none for a one-off alarm" FontSize="10.5"
                           Foreground="{StaticResource SubtleTextBrush}" Margin="0,2,0,8" />
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource AccentPill}" Content="Add alarm" Click="AddAlarm_Click" />
                    <TextBlock x:Name="AlarmError" FontSize="11" Foreground="#FFFF9B9B" VerticalAlignment="Center" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>

            <!-- Timer -->
            <StackPanel x:Name="TimerPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock x:Name="TimerDisplay" Style="{StaticResource BigDigits}" Text="00:00" />
                <Border x:Name="TimerTrack" Height="4" CornerRadius="2" Background="#26FFFFFF" Margin="0,6,0,12">
                    <Border x:Name="TimerFill" HorizontalAlignment="Left" Width="0" CornerRadius="2" Background="{StaticResource AccentBrush}" />
                </Border>
                <WrapPanel x:Name="TimerPresets" HorizontalAlignment="Center" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TimerInput" Style="{StaticResource GlassInput}" Tag="Minutes, or 1:30 / 1:00:00"
                             KeyDown="TimerInput_KeyDown" />
                    <Button x:Name="TimerStartButton" Grid.Column="1" Style="{StaticResource AccentPill}" Content="Start"
                            Margin="8,0,0,0" MinWidth="70" Click="TimerStart_Click" />
                    <Button x:Name="TimerResetButton" Grid.Column="2" Style="{StaticResource PillButton}" Content="Reset"
                            Margin="6,0,0,0" Click="TimerReset_Click" />
                </Grid>
                <TextBlock x:Name="TimerError" FontSize="11" Foreground="#FFFF9B9B" Margin="0,6,0,0" Visibility="Collapsed" />
            </StackPanel>

            <!-- Stopwatch -->
            <StackPanel x:Name="StopwatchPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBlock x:Name="StopwatchDisplay" Style="{StaticResource BigDigits}" Text="00:00.0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,10">
                    <Button x:Name="StopwatchStartButton" Style="{StaticResource AccentPill}" Content="Start" MinWidth="70"
                            Click="StopwatchStart_Click" />
                    <Button x:Name="StopwatchLapButton" Style="{StaticResource PillButton}" Content="Lap" Margin="6,0,0,0"
                            Click="StopwatchLap_Click" />
                    <Button Style="{StaticResource PillButton}" Content="Reset" Margin="6,0,0,0" Click="StopwatchReset_Click" />
                </StackPanel>
                <StackPanel x:Name="LapList" />
            </StackPanel>
        </StackPanel>

        <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}" Placement="Bottom"
               HorizontalOffset="-180" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Width="210">
                <StackPanel>
                    <TextBlock Text="Clock" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />
                    <CheckBox x:Name="SecondsToggle" Style="{StaticResource ToggleSwitch}" Content="Show seconds"
                              FontSize="12" Margin="0,0,0,10" Click="ClockOption_Click" />
                    <CheckBox x:Name="Hour24Toggle" Style="{StaticResource ToggleSwitch}" Content="24-hour clock"
                              FontSize="12" Click="ClockOption_Click" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
