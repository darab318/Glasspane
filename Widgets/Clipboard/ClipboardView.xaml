<UserControl x:Class="Glasspane.Widgets.Clipboard.ClipboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CardButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Each clipboard item card -->
        <DataTemplate x:Key="EntryTemplate">
            <Border x:Name="Card" Background="{DynamicResource CardBackground}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="9" Padding="12,9,8,8" Margin="0,0,0,6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Text -->
                    <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               MaxHeight="92" FontSize="13" LineHeight="18" Margin="0,0,4,0"
                               Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />

                    <!-- Image -->
                    <Border CornerRadius="4" HorizontalAlignment="Left" ClipToBounds="True"
                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}">
                        <Image Source="{Binding Thumbnail}" MaxHeight="150" Stretch="Uniform"
                               HorizontalAlignment="Left" />
                    </Border>

                    <!-- Files -->
                    <Grid Visibility="{Binding IsFiles, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="20"
                                   VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource AccentBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding FilesTitle}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding FilesDetail}" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>

                    <!-- Footer: source app, time, size + actions -->
                    <Grid Grid.Row="1" Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE840;" FontFamily="{StaticResource IconFont}" FontSize="10"
                                   Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,6,0"
                                   Visibility="{Binding Pinned, Converter={StaticResource BoolToVis}}" />
                        <TextBlock Grid.Column="1" Text="{Binding MetaText}" FontSize="11" VerticalAlignment="Center"
                                   Foreground="{StaticResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel x:Name="Actions" Grid.Column="2" Orientation="Horizontal" Opacity="0">
                            <Button Style="{StaticResource CardButton}" Content="&#xE77F;" ToolTip="Paste into last app (Enter)"
                                    Click="PasteButton_Click" />
                            <Button Style="{StaticResource CardButton}" Content="&#xE718;" ToolTip="Pin / unpin"
                                    Click="PinButton_Click" />
                            <Button Style="{StaticResource CardButton}" Content="&#xE74D;" ToolTip="Delete (Del)"
                                    Click="DeleteButton_Click" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="#55FFFFFF" />
                    <Setter TargetName="Card" Property="Background" Value="#26FFFFFF" />
                </DataTrigger>
                <!-- Selection only shows while you're using the widget, like desktop icons -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                        <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Card" Property="BorderBrush" Value="#B37AB4FF" />
                    <Setter TargetName="Card" Property="Background" Value="#337AB4FF" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ContextMenu x:Key="EntryMenu" x:Shared="False">
            <MenuItem Header="Copy" Click="MenuCopy_Click" />
            <MenuItem Header="Copy as plain text" Click="MenuCopyPlain_Click" />
            <MenuItem Header="Paste into last app" Click="MenuPaste_Click" />
            <Separator />
            <MenuItem Header="{Binding PinMenuText}" Click="MenuPin_Click" />
            <MenuItem Header="Open file location" Click="MenuOpenLocation_Click"
                      Visibility="{Binding IsFiles, Converter={StaticResource BoolToVis}}" />
            <MenuItem Header="Open image" Click="MenuOpenImage_Click"
                      Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
            <Separator />
            <MenuItem Header="Delete" Click="MenuDelete_Click" />
        </ContextMenu>

        <Style x:Key="EntryItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="ContextMenu" Value="{StaticResource EntryMenu}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <EventSetter Event="MouseLeftButtonUp" Handler="Item_MouseLeftButtonUp" />
            <EventSetter Event="MouseDoubleClick" Handler="Item_MouseDoubleClick" />
        </Style>

    </UserControl.Resources>

    <Grid Margin="12,0,6,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Search + more -->
        <Grid x:Name="SearchRow" Margin="0,0,6,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" Tag="Search clipboard history"
                     TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" />
            <Button x:Name="MoreButton" Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE712;"
                    Height="32" Width="32" Margin="6,0,0,0" ToolTip="More" Click="MoreButton_Click">
                <Button.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Clear history (keeps pinned)" Click="ClearHistory_Click" />
                        <MenuItem Header="Open images folder" Click="OpenImagesFolder_Click" />
                    </ContextMenu>
                </Button.ContextMenu>
            </Button>
        </Grid>

        <!-- Filters -->
        <StackPanel x:Name="FilterRow" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <RadioButton Style="{StaticResource Chip}" Content="All" Tag="All" IsChecked="True" GroupName="Filter" Checked="Filter_Checked" />
            <RadioButton Style="{StaticResource Chip}" Content="Text" Tag="Text" GroupName="Filter" Checked="Filter_Checked" />
            <RadioButton Style="{StaticResource Chip}" Content="Images" Tag="Images" GroupName="Filter" Checked="Filter_Checked" />
            <RadioButton Style="{StaticResource Chip}" Content="Files" Tag="Files" GroupName="Filter" Checked="Filter_Checked" />
            <RadioButton Style="{StaticResource Chip}" Content="Pinned" Tag="Pinned" GroupName="Filter" Checked="Filter_Checked" />
        </StackPanel>

        <!-- History -->
        <ListBox x:Name="List" Grid.Row="2" Background="Transparent" BorderThickness="0" Padding="0,0,6,0"
                 Foreground="{StaticResource TextBrush}"
                 ItemTemplate="{StaticResource EntryTemplate}" ItemContainerStyle="{StaticResource EntryItem}"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.CanContentScroll="True"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 SelectionMode="Single"
                 PreviewKeyDown="List_KeyDown"
                 ScrollViewer.ScrollChanged="List_ScrollChanged" />

        <!-- Empty state -->
        <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                    IsHitTestVisible="False" Visibility="Collapsed">
            <TextBlock Text="&#xE77F;" FontFamily="{StaticResource IconFont}" FontSize="28" HorizontalAlignment="Center" Opacity="0.5" />
            <TextBlock x:Name="EmptyText" Text="Copy something and it will appear here" Margin="0,10,0,0"
                       Foreground="{StaticResource SubtleTextBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Status line -->
        <DockPanel x:Name="StatusRow" Grid.Row="3" Margin="0,6,6,0">
            <TextBlock DockPanel.Dock="Right" Text="Ctrl+Alt+V" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
            <TextBlock x:Name="StatusText" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
        </DockPanel>

        <!-- "Copied" toast -->
        <Border x:Name="Toast" Grid.Row="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                Background="{StaticResource AccentBrush}" CornerRadius="14" Padding="14,6" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="#FF0B1220" FontSize="12" FontWeight="SemiBold" />
        </Border>
    </Grid>
</UserControl>
