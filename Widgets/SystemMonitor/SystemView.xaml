<UserControl x:Class="Glasspane.Widgets.SystemMonitor.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}"
             Background="Transparent">

    <Grid Margin="16,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Options (fades away on the desktop when you're not using the widget) -->
        <Button x:Name="OptionsButton" Style="{StaticResource IconButton}" Content="&#xE9E9;"
                HorizontalAlignment="Right" ToolTip="Choose what to show" Click="OptionsButton_Click"
                Margin="0,-4,0,2" />

        <StackPanel x:Name="Cards" Grid.Row="1" />

        <TextBlock x:Name="NothingShown" Grid.Row="1" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12"
                   Foreground="{StaticResource SubtleTextBrush}" Margin="0,4,0,8"
                   Text="Everything is switched off. Use the options button above to choose what to show." />

        <Popup x:Name="OptionsPopup" PlacementTarget="{Binding ElementName=OptionsButton}"
               Placement="Bottom" HorizontalOffset="-230" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Width="260">
                <StackPanel>
                    <TextBlock Text="System readings" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="58" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="1" Text="Show" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock Grid.Column="2" Text="Details" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" />

                        <TextBlock Grid.Row="1" Text="CPU" FontSize="12" VerticalAlignment="Center" />
                        <CheckBox x:Name="ShowCpu" Grid.Row="1" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Option_Click" />
                        <CheckBox x:Name="CpuDetail" Grid.Row="1" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Option_Click" />

                        <TextBlock Grid.Row="2" Text="Memory" FontSize="12" VerticalAlignment="Center" />
                        <CheckBox x:Name="ShowMemory" Grid.Row="2" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Option_Click" />
                        <CheckBox x:Name="MemoryDetail" Grid.Row="2" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Option_Click" />

                        <TextBlock Grid.Row="3" Text="Disk" FontSize="12" VerticalAlignment="Center" />
                        <CheckBox x:Name="ShowDisk" Grid.Row="3" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Option_Click" />
                        <CheckBox x:Name="DiskDetail" Grid.Row="3" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Option_Click" />

                        <TextBlock Grid.Row="4" Text="GPU" FontSize="12" VerticalAlignment="Center" />
                        <CheckBox x:Name="ShowGpu" Grid.Row="4" Grid.Column="1" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Option_Click" />
                        <CheckBox x:Name="GpuDetail" Grid.Row="4" Grid.Column="2" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Click="Option_Click" />
                    </Grid>

                    <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,10,0,10" />
                    <CheckBox x:Name="ShowGraphs" Style="{StaticResource ToggleSwitch}" Content="History graphs"
                              FontSize="12" Click="Option_Click" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
