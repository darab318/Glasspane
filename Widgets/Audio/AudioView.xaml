<UserControl x:Class="Glasspane.Widgets.Audio.AudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{StaticResource TextBrush}"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Round glass mute button -->
        <Style x:Key="RoundButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Width="{TemplateBinding Width}" Height="{TemplateBinding Height}"
                                CornerRadius="100" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#4DFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Output device pill: one click makes it the default -->
        <Style x:Key="DevicePill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="14" Padding="11,5,13,5" Background="#14FFFFFF"
                                BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#29FFFFFF" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                <Setter Property="Foreground" Value="#FF0B1220" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource SubtleTextBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="16,4,16,14">

        <!-- Mute button, device name, big percentage -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="MuteButton" Style="{StaticResource RoundButton}" Width="42" Height="42" FontSize="17"
                    Content="&#xE995;" ToolTip="Mute" Click="MuteButton_Click" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,8,0">
                <TextBlock x:Name="DeviceName" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DeviceDetail" FontSize="11" Foreground="{StaticResource SubtleTextBrush}"
                           TextTrimming="CharacterEllipsis" Text="Output" />
            </StackPanel>
            <TextBlock x:Name="PercentText" Grid.Column="2" FontSize="28" FontWeight="Light"
                       VerticalAlignment="Center" Text="0" />
        </Grid>

        <!-- Volume, with a live level meter underneath -->
        <Slider x:Name="VolumeSlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="100"
                SmallChange="1" LargeChange="10" Margin="0,12,0,0" ValueChanged="VolumeSlider_ValueChanged" />
        <Border x:Name="MeterTrack" Height="3" CornerRadius="1.5" Background="#14FFFFFF" Margin="9,1,9,0">
            <Border x:Name="MeterFill" HorizontalAlignment="Left" Width="0" CornerRadius="1.5">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#997AB4FF" Offset="0" />
                        <GradientStop Color="#FFB4E0FF" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>
        </Border>

        <!-- Outputs: click one to switch to it -->
        <ItemsControl x:Name="DeviceList" Margin="0,14,0,0" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource DevicePill}" ToolTip="{Binding FullName}" Click="Device_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13"
                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="{Binding ShortName}" FontSize="12" VerticalAlignment="Center"
                                       MaxWidth="150" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Per-app volumes -->
        <Button x:Name="AppsToggle" Style="{StaticResource LinkButton}" Margin="2,2,0,0" HorizontalAlignment="Left"
                Click="AppsToggle_Click">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="App volumes" FontSize="12" VerticalAlignment="Center" />
                <TextBlock x:Name="AppsChevron" Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9"
                           VerticalAlignment="Center" Margin="6,1,0,0" />
            </StackPanel>
        </Button>

        <ItemsControl x:Name="AppList" Visibility="Collapsed" Margin="0,6,0,0" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="112" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" FontSize="12"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                        <Slider Grid.Column="1" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="100"
                                SmallChange="1" LargeChange="10" VerticalAlignment="Center"
                                Value="{Binding Volume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}}" FontSize="11" Width="26"
                                   TextAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}" />
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="26" Height="24" FontSize="11"
                                Content="{Binding MuteGlyph}" ToolTip="Mute this app" Click="AppMute_Click" Margin="4,0,0,0" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="NoApps" Text="No apps are playing sound" FontSize="11" Visibility="Collapsed"
                   Foreground="{StaticResource SubtleTextBrush}" Margin="2,4,0,0" />
    </StackPanel>
</UserControl>
