<Window x:Class="Glasspane.Shell.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glasspane"
        Width="380" Height="580" MinWidth="260" MinHeight="200"
        WindowStyle="None" ResizeMode="CanResize"
        AllowsTransparency="True" Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">

    <!-- True per-pixel transparency (a layered window): wherever nothing is drawn, you see the
         wallpaper itself. WindowChrome is only used for native edge resizing. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="0" ResizeBorderThickness="6"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <!-- Almost-invisible fill so the widget still notices the mouse over empty areas -->
        <Border Background="#01000000" CornerRadius="12" />

        <!-- Desktop-mode blur: a copy of the wallpaper behind the widget, blurred by any amount -->
        <Grid x:Name="BlurHost" Visibility="Collapsed" IsHitTestVisible="False">
            <Grid x:Name="BlurLayer">
                <Rectangle x:Name="WallpaperFill" />
                <Rectangle x:Name="WallpaperImage" />
            </Grid>
        </Grid>

        <!-- The panel. In window mode it's a tinted glass sheet; on the desktop it fades away. -->
        <Border x:Name="Panel" CornerRadius="12">
            <Border.Background>
                <SolidColorBrush Color="#00161A22" />
            </Border.Background>
        </Border>
        <Border x:Name="Edge" CornerRadius="12" BorderThickness="1" IsHitTestVisible="False">
            <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#40FFFFFF" Offset="0" />
                    <GradientStop Color="#14FFFFFF" Offset="1" />
                </LinearGradientBrush>
            </Border.BorderBrush>
        </Border>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: the title stays as a quiet label; buttons appear on hover when on the desktop -->
            <Grid x:Name="TitleBar" Height="40" Background="#01000000"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel x:Name="TitleLabel" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="16,0,0,0" IsHitTestVisible="False">
                    <TextBlock x:Name="ModeGlyph" FontFamily="{StaticResource IconFont}" FontSize="12"
                               VerticalAlignment="Center" Opacity="0.75" Margin="0,0,8,0" Text="&#xE8C8;" />
                    <TextBlock x:Name="TitleText" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel x:Name="TitleButtons" Orientation="Horizontal" HorizontalAlignment="Right"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <Button x:Name="LockButton" Style="{StaticResource IconButton}" Content="&#xE785;"
                            ToolTip="Lock position" Click="LockButton_Click" Visibility="Collapsed" />
                    <Button x:Name="PinButton" Style="{StaticResource IconButton}" Content="&#xE718;"
                            ToolTip="Put on desktop" Click="PinButton_Click" />
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" Content="&#xE713;"
                            ToolTip="Appearance" Click="SettingsButton_Click" />
                    <Button x:Name="MinimizeButton" Style="{StaticResource IconButton}" Content="&#xE921;"
                            ToolTip="Minimise" Click="MinimizeButton_Click" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            ToolTip="Hide (still running in the tray)" Click="CloseButton_Click" />
                </StackPanel>
            </Grid>

            <!-- One section per widget, stacked top to bottom -->
            <Grid x:Name="Sections" Grid.Row="1" />
        </Grid>

        <!-- Shown when another widget window is dragged over this one -->
        <Border x:Name="DropHint" CornerRadius="12" BorderThickness="2" Visibility="Collapsed"
                IsHitTestVisible="False" Background="#337AB4FF" BorderBrush="{StaticResource AccentBrush}">
            <Border Background="{StaticResource AccentBrush}" CornerRadius="14" Padding="14,6"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Release to join" Foreground="#FF0B1220" FontWeight="SemiBold" FontSize="12" />
            </Border>
        </Border>

        <!-- Appearance settings -->
        <Popup x:Name="SettingsPopup" PlacementTarget="{Binding ElementName=SettingsButton}"
               Placement="Bottom" HorizontalOffset="-210" VerticalOffset="6"
               StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="{StaticResource PopupBrush}" BorderBrush="{StaticResource StrokeBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="16,14" Width="260">
                <StackPanel>
                    <TextBlock x:Name="AppearanceTitle" Text="Appearance" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,12" />

                    <DockPanel Margin="0,0,0,2">
                        <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                        <TextBlock Text="Background" FontSize="12" />
                    </DockPanel>
                    <Slider x:Name="OpacitySlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="100"
                            SmallChange="1" LargeChange="10" ValueChanged="OpacitySlider_ValueChanged" />
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Solid" DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock Text="Invisible" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" />
                    </DockPanel>

                    <DockPanel Margin="0,0,0,2">
                        <TextBlock x:Name="BlurValue" DockPanel.Dock="Right" Foreground="{StaticResource SubtleTextBrush}" FontSize="12" />
                        <TextBlock Text="Blur" FontSize="12" />
                    </DockPanel>
                    <Slider x:Name="BlurSlider" Style="{StaticResource GlassSlider}" Minimum="0" Maximum="100"
                            SmallChange="1" LargeChange="10" ValueChanged="BlurSlider_ValueChanged" />
                    <DockPanel Margin="0,0,0,12">
                        <TextBlock Text="Heavy" DockPanel.Dock="Right" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" />
                        <TextBlock Text="None" FontSize="10" Foreground="{StaticResource SubtleTextBrush}" />
                    </DockPanel>
                    <CheckBox x:Name="PinnedToggle" Style="{StaticResource ToggleSwitch}" Content="Part of the desktop"
                              FontSize="12" Margin="0,0,0,10" Click="PinnedToggle_Click" />
                    <CheckBox x:Name="LockToggle" Style="{StaticResource ToggleSwitch}" Content="Lock position on desktop"
                              FontSize="12" Click="LockToggle_Click" />

                    <TextBlock Text="Window and desktop mode each remember their own look."
                               FontSize="10.5" TextWrapping="Wrap" Margin="0,12,0,0"
                               Foreground="{StaticResource SubtleTextBrush}" />
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</Window>
